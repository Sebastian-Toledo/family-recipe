# En local NO hace falta crear este archivo: `npm run dev` genera .env.local solo.
# Estas son las variables a cargar en Vercel (Settings → Environment Variables).
# Nunca subas a GitHub un archivo .env con valores reales (.env* está en .gitignore).

# Secreto para firmar sesiones. Generalo con: npx @better-auth/cli secret
BETTER_AUTH_SECRET=

# URL pública de la app (en local: http://localhost:3000)
BETTER_AUTH_URL=https://tu-recetario.vercel.app

# Base de datos. En local es un archivo; en producción, la URL de Turso.
DATABASE_URL=libsql://tu-base-tu-usuario.turso.io
DATABASE_AUTH_TOKEN=

# Fotos en producción: Vercel la completa sola al conectar un Blob Store al proyecto.
# Sin esta variable, las fotos se guardan en la carpeta data/uploads (sólo sirve en local).
BLOB_READ_WRITE_TOKEN=

# Tu cuenta. El registro está cerrado: sólo puede entrar esta cuenta.
# Se crea (o se actualiza la contraseña) en cada deploy y en cada `npm run dev`.
ADMIN_EMAIL=
# Mínimo 8 caracteres. Si la dejás vacía, se entra sólo con Google.
ADMIN_PASSWORD=
# Opcional: el nombre que se muestra.
ADMIN_NAME=

# Opcional: ingresar con Google (sólo deja entrar a ADMIN_EMAIL). Ver README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcional: ALLOW_SIGNUP=true vuelve a abrir el registro para la familia,
# y con INVITE_CODE sólo puede registrarse quien tenga el código.
ALLOW_SIGNUP=
INVITE_CODE=
