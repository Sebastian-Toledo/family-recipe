# En local NO hace falta crear este archivo: `npm run dev` genera .env.local solo.
# Estas son las variables a cargar en Vercel (Settings → Environment Variables).

# Secreto para firmar sesiones. Generalo con: npx @better-auth/cli secret
BETTER_AUTH_SECRET=

# URL pública de la app (en local: http://localhost:3000)
BETTER_AUTH_URL=https://tu-recetario.vercel.app

# Base de datos. En local es un archivo; en producción, la URL de Turso.
DATABASE_URL=libsql://tu-base-tu-usuario.turso.io
DATABASE_AUTH_TOKEN=

# Fotos en producción: Vercel la completa sola al conectar un Blob Store al proyecto.
# Sin esta variable, las fotos se guardan en la carpeta data/uploads (sólo sirve en local).
BLOB_READ_WRITE_TOKEN=

# Opcional: si se define, para crear una cuenta hay que ingresar este código.
INVITE_CODE=
